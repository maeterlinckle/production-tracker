APP_NAME="Production Tracker"
APP_PRODUCT="Production Tracker"
APP_FULL_NAME="Production Tracker by Junction"
APP_TAGLINE="Job Shop Order Tracking"
APP_MARK="PT"
APP_VENDOR="Junction Inc Ltd"
APP_VENDOR_URL="https://www.junctioninc.co.uk/"

APP_ENV=production
APP_DEBUG=false
# Full base URL this app is served at, no trailing slash. Required so links
# in emails/PDFs and the router's base-path handling are correct behind a
# reverse proxy (Caddy/OPNsense).
APP_URL=https://tracker.junctioninc.co.uk
APP_TIMEZONE=Europe/London
APP_CURRENCY=GBP
APP_CURRENCY_SYMBOL=£

# Generate with: php bin/console.php key:generate
APP_KEY=

# Trust the reverse proxy's X-Forwarded-* headers. Set to the proxy's IP(s),
# comma separated, or "*" only if the app is never reachable except through
# that proxy.
TRUSTED_PROXIES=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=production_tracker
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=pt_session
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true

STORAGE_PATH=storage

MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@junctioninc.co.uk
MAIL_FROM_NAME="Junction Production Tracker"

# Clear Books REST API. Authentication is OAuth 2 (authorization code grant,
# confidential client, PKCE) — there is no static API key. Request API access and
# register a client at https://www.clearbooks.co.uk/support/api/ first; see
# docs/INSTALL.md for the one-time connect flow.
#
# The API and OAuth endpoints are not configurable — they are published in the
# Clear Books OpenAPI description and live as constants in the client class.
# Only the credentials belong here, and they can also be set from Settings.
CLEARBOOKS_CLIENT_ID=
CLEARBOOKS_CLIENT_SECRET=
CLEARBOOKS_REDIRECT_URI=https://tracker.junctioninc.co.uk/staff/settings/clearbooks/callback

LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_LOCKOUT_MINUTES=15
