{
    "name": "junction/production-tracker",
    "description": "Self-hosted job shop order tracker for Junction Inc Ltd: client quotes, orders, free-issue material, workshop production, delivery notes and invoicing.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "make-admin": "php bin/create-admin.php"
    }
}
